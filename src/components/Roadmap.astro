---
/**
 * Roadmap.astro
 * -------------
 * The construction roadmap timeline. Horizontal dots-on-a-line on
 * desktop (matching the approved deck design); collapses to a
 * vertical timeline on small screens.
 *
 * Used by: progress.astro.
 *
 * Data source: src/data/pages/progress.json (roadmap.milestones) —
 * edit milestones THERE.
 * Each milestone's `status` drives its look automatically:
 *   done     → solid navy dot
 *   current  → gold dot with a glow, gold label
 *   upcoming → hollow muted dot, muted label
 */
import content from '../data/pages/progress.json';

const milestones = content.roadmap.milestones;
---

<!-- --cols is read by the CSS grid rule so column count tracks the data -->
<ol class="timeline" style={`--cols: ${milestones.length}`}>
  {
    milestones.map((m) => (
      <li class={m.status}>
        <span class="dot" aria-hidden="true" />
        <p class="label">
          {m.label}
          {/* Screen readers hear the status; sighted users see the dot color */}
          <span class="sr-only">
            {m.status === 'done' && ' (completed)'}
            {m.status === 'current' && ' (current phase)'}
          </span>
        </p>
        <h3>{m.title}</h3>
        <p class="body">{m.body}</p>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    list-style: none;
    display: grid;
    /* --cols is set inline from the milestones array length, so adding or
       removing a milestone in progress.json automatically widens/narrows the grid. */
    grid-template-columns: repeat(var(--cols, 5), 1fr);
    gap: 1.4rem;
  }

  li {
    position: relative;
    padding-top: 2.2rem;
  }

  /* The connecting line: drawn as a border on each item's top area,
     positioned behind the dots. */
  li::before {
    content: '';
    position: absolute;
    top: 9px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--cream-deep);
  }
  li:first-child::before {
    left: 10px;
  }
  /* Last item: shorten the line to just cover up to the dot — no next
     milestone to connect to, so the line stops right of the dot. */
  li:last-child::before {
    right: auto;
    width: 10px;
  }

  .dot {
    position: absolute;
    top: 0;
    left: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--navy);
    z-index: 1;
  }
  li.current .dot {
    background: var(--gold);
    box-shadow: 0 0 0 6px rgba(210, 166, 47, 0.25);
  }
  li.upcoming .dot {
    background: var(--paper);
    border: 4px solid var(--cream-deep);
  }

  .label {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.2rem;
  }
  li.done .label,
  li.current .label {
    color: var(--gold-text);
  }

  h3 {
    font-size: 1.15rem;
    color: var(--navy);
    margin-bottom: 0.3rem;
  }
  .body {
    font-size: 0.88rem;
    color: var(--ink-muted);
  }

  /* Mobile: vertical timeline — dots down the left edge. */
  @media (max-width: 820px) {
    .timeline {
      grid-template-columns: 1fr;
      gap: 0;
    }
    li {
      padding: 0 0 2rem 2.4rem;
    }
    li::before {
      top: 10px;
      bottom: 0;
      left: 9px;
      right: auto;
      width: 2px;
      height: auto;
    }
    li:first-child::before {
      left: 9px;
    }
    li:last-child::before {
      display: none;
    }
  }
</style>
