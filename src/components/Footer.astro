---
/**
 * Footer.astro
 * ------------
 * Site-wide footer, per the approved design:
 *   1. Wave divider — navy wave with a gold stroke along its crest,
 *      flowing from the cream page into the dark footer.
 *   2. Three columns on navy:
 *      LEFT   — tagline + refugee-led description
 *               (REGISTRATION SLOT: replace with official registration
 *               line when it exists) + Privacy / Safeguarding links.
 *      CENTER — "Follow us" circular icons (Facebook, LinkedIn, GoFundMe, email)
 *               + copyright line.
 *      RIGHT  — "Contact Us": location + email.
 *
 * Used by: BaseLayout.astro (appears on every page).
 *
 * MAINTAINER NOTES:
 * - Contact details, tagline, and URLs come from src/config/site.ts —
 *   edit them THERE, not here.
 * - The wave is decorative, so it is marked aria-hidden.
 */
import { SITE, LINKS } from '../config/site';
---

<footer>
  <!-- 1. Wave divider: navy fill + separate gold stroke on the crest -->
  <div class="wave" aria-hidden="true">
    <svg viewBox="0 0 1440 110" preserveAspectRatio="none">
      <path
        d="M0 85 C 260 100 460 25 760 38 C 1040 50 1240 30 1440 55 L1440 110 L0 110 Z"
        fill="var(--navy)"></path>
      <path
        d="M0 85 C 260 100 460 25 760 38 C 1040 50 1240 30 1440 55"
        fill="none"
        stroke="var(--gold)"
        stroke-width="3"></path>
    </svg>
  </div>

  <!-- 2. Three-column navy footer -->
  <div class="body">
    <div class="container cols">
      <!-- LEFT: org statement. REGISTRATION SLOT — when official
           registration exists, replace the two lines below with the
           registration/status statement (like a 501(c)(3) + EIN). -->
      <div class="col org">
        <p class="tagline">{SITE.tagline}</p>
        <p class="desc">
          Golden Mind Academy is a refugee-led school project building safe classrooms for refugee
          and host-community children in Ayilo I Refugee Settlement, Uganda.
        </p>
        <p class="legal">
          <a href="/privacy-policy/">Privacy Policy</a>
          <span aria-hidden="true"> | </span>
          <a href="/safeguarding-children/">Safeguarding Children</a>
        </p>
      </div>

      <!-- CENTER: social + copyright -->
      <div class="col follow">
        <h2 class="heading">Follow us</h2>
        <ul class="icons">
          <li>
            <a href={LINKS.facebook} target="_blank" rel="noopener">
              <span class="sr-only">Facebook</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.5-1.5h1.4V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7z"
                  fill="currentColor"></path>
              </svg>
            </a>
          </li>
          <li>
            <a href={LINKS.linkedin} target="_blank" rel="noopener">
              <span class="sr-only">LinkedIn</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M6.94 8.5H3.56V20h3.38V8.5zM5.25 4a1.96 1.96 0 1 0 0 3.92 1.96 1.96 0 0 0 0-3.92zM20.44 20h-3.37v-5.6c0-1.34-.03-3.06-1.87-3.06-1.87 0-2.16 1.46-2.16 2.96V20H9.68V8.5h3.24v1.57h.05c.45-.86 1.56-1.77 3.2-1.77 3.42 0 4.05 2.25 4.05 5.18V20z"
                  fill="currentColor"></path>
              </svg>
            </a>
          </li>
          <li>
            <a href={LINKS.gofundme} target="_blank" rel="noopener">
              <span class="sr-only">GoFundMe</span>
              <!-- Heart-in-hand style mark standing in for GoFundMe -->
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M12 20s-6.5-4.3-8.4-8C2.3 9.4 3.6 6.5 6.4 6c1.7-.3 3.4.5 4.3 2 .2.4.9.4 1.1 0 .9-1.5 2.6-2.3 4.3-2 2.8.5 4.1 3.4 2.8 6-1.9 3.7-6.9 8-6.9 8z"
                  fill="currentColor"></path>
              </svg>
            </a>
          </li>
          <li>
            <a href={LINKS.email}>
              <span class="sr-only">Email</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect
                  x="3.5"
                  y="5.5"
                  width="17"
                  height="13"
                  rx="1.5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"></rect>
                <path
                  d="M4 7l8 6 8-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"></path>
              </svg>
            </a>
          </li>
        </ul>
        <p class="copyright">© {SITE.name} {SITE.copyrightYear} | All rights reserved.</p>
      </div>

      <!-- RIGHT: contact -->
      <div class="col contact">
        <h2 class="heading">Contact Us</h2>
        <address>
          {SITE.location.line1}<br />
          {SITE.location.line2}<br />
          {SITE.location.line3}<br />
          <a href={LINKS.email}>{SITE.email}</a>
        </address>
      </div>
    </div>
  </div>
</footer>

<style>
  .wave {
    background: var(--cream);
    line-height: 0;
  }
  .wave svg {
    width: 100%;
    height: clamp(60px, 8vw, 110px);
    display: block;
  }

  .body {
    background: var(--navy);
    color: rgba(241, 235, 220, 0.85);
    padding: 2.5rem 0 3.5rem;
  }

  .cols {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr;
    gap: 3rem;
  }

  .heading {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    color: var(--cream);
    margin-bottom: 0.9rem;
  }

  /* LEFT column */
  .tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--gold-soft);
    margin-bottom: 0.6rem;
  }
  .desc {
    font-size: 0.88rem;
    max-width: 34ch;
    margin-bottom: 1.1rem;
  }
  .legal a {
    color: var(--gold-soft);
    font-size: 0.88rem;
  }

  /* CENTER column */
  .follow {
    text-align: center;
  }
  .icons {
    list-style: none;
    display: flex;
    justify-content: center;
    gap: 0.9rem;
    margin-bottom: 1.1rem;
  }
  .icons a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--cream);
    color: var(--navy);
    transition: background 0.15s ease;
  }
  .icons a:hover {
    background: var(--gold);
  }
  .icons svg {
    width: 21px;
    height: 21px;
  }
  .copyright {
    font-size: 0.85rem;
  }

  /* RIGHT column */
  .contact {
    text-align: right;
  }
  address {
    font-style: normal;
    font-size: 0.92rem;
    line-height: 1.9;
  }
  address a {
    color: var(--gold-soft);
  }

  @media (max-width: 820px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 2.2rem;
      text-align: center;
    }
    .desc {
      margin-inline: auto;
    }
    .contact {
      text-align: center;
    }
  }
</style>
