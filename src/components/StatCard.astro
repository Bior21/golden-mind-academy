---
/**
 * StatCard.astro
 * --------------
 * A single statistic: big display number + short label beneath.
 *
 * Used by: index.astro ("The need in Ayilo" band) and
 *          programs.astro (who we serve).
 *
 * Props:
 * - value:  The number/figure as display text, e.g. "39,000+".
 * - label:  What the figure means, e.g. "refugees living in Ayilo".
 * - onDark: Set true when the card sits on a navy background.
 */
interface Props {
  value: string;
  label: string;
  onDark?: boolean;
}
const { value, label, onDark = false } = Astro.props;
---

<div class:list={['stat', { dark: onDark }]}>
  <p class="value">{value}</p>
  <p class="label">{label}</p>
</div>

<style>
  .stat {
    border-left: 3px solid var(--gold);
    padding-left: 1rem;
  }
  .value {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 600;
    line-height: 1.1;
    color: var(--navy);
  }
  .label {
    font-size: 0.88rem;
    color: var(--ink-muted);
    max-width: 22ch;
  }
  .stat.dark .value {
    color: var(--cream);
  }
  .stat.dark .label {
    color: #BCC8D6;
  }
</style>
