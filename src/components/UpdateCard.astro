---
/**
 * UpdateCard.astro
 * ----------------
 * One entry in the Updates feed: date eyebrow + category pill +
 * headline + optional arch-framed photos + body text. Rendered
 * inside the vertical timeline on the Progress page (gold dot
 * markers echoing the Roadmap), or standalone as a homepage teaser.
 *
 * Used by: progress.astro (full feed), index.astro (latest teasers).
 *
 * Props:
 * - update: One entry from the "updates" content collection
 *           (see src/content/config.ts for its fields).
 * - teaser: When true, renders compact — no photos, no body — for
 *           the homepage "latest updates" strip.
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  update: CollectionEntry<'updates'>;
  teaser?: boolean;
}
const { update, teaser = false } = Astro.props;
const { title, date, category, photos } = update.data;

/** e.g. "2 June 2026" */
const displayDate = date.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/* The rendered Markdown body — only needed for the full (non-teaser)
   card, but hooks must be called unconditionally. */
const { Content } = await update.render();
---

<article class:list={['update', { teaser }]}>
  <p class="meta">
    <time datetime={date.toISOString().slice(0, 10)}>{displayDate}</time>
    <span class="pill">{category}</span>
  </p>
  <h3>{title}</h3>

  {
    !teaser && photos && photos.length > 0 && (
      <div class="photos" data-count={Math.min(photos.length, 4)} data-photos={JSON.stringify(photos)}>
        {photos.slice(0, 4).map((photo, i) => (
          <figure class="photo-tile" data-index={i}>
            <img
              src={photo.src}
              alt={photo.caption}
              loading="lazy"
              style={`object-position: ${photo.focus || 'center'}`}
            />
            {i === 3 && photos.length > 4 && <span class="more-overlay">+{photos.length - 4}</span>}
          </figure>
        ))}
      </div>
    )
  }

  {
    !teaser && (
      <div class="body">
        <Content />
      </div>
    )
  }
</article>

<style>
  .update {
    background: var(--paper);
    border: 1px solid var(--cream-deep);
    border-radius: 12px;
    padding: 1.6rem 1.8rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 0.4rem;
  }
  time {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .pill {
    font-size: 0.72rem;
    font-weight: 600;
    background: var(--navy);
    color: var(--cream);
    border-radius: 999px;
    padding: 0.15rem 0.7rem;
  }

  h3 {
    font-size: 1.3rem;
    color: var(--navy);
    margin-bottom: 0.6rem;
  }

  /* Facebook-style mosaic: layout depends on photo count (capped at
     4 visible tiles; a 5th+ photo shows as a "+N" overlay on the
     4th tile). Every tile is clickable — see PhotoLightbox.astro,
     which reads the full photo list from data-photos below. */
  .photos {
    display: grid;
    gap: 4px;
    margin: 1rem 0;
    border-radius: 10px;
    overflow: hidden;
  }
  .photo-tile {
    position: relative;
    margin: 0;
    overflow: hidden;
  }
  .photo-tile img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    cursor: pointer;
  }
  .more-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(16, 26, 48, 0.55);
    color: #fff;
    font-family: var(--font-display);
    font-size: 1.7rem;
    font-weight: 600;
    cursor: pointer;
  }

  /* 1 photo: full width, capped so it doesn't overwhelm the card */
  .photos[data-count='1'] {
    grid-template-columns: 1fr;
    max-width: 520px;
  }
  .photos[data-count='1'] .photo-tile {
    aspect-ratio: 16 / 9;
  }

  /* 2 photos: side by side, square-ish */
  .photos[data-count='2'] {
    grid-template-columns: 1fr 1fr;
  }
  .photos[data-count='2'] .photo-tile {
    aspect-ratio: 1 / 1;
  }

  /* 3 photos: one large left, two stacked right */
  .photos[data-count='3'] {
    grid-template-columns: 1.4fr 1fr;
    grid-template-rows: 1fr 1fr;
    height: clamp(260px, 36vw, 360px);
  }
  .photos[data-count='3'] .photo-tile {
    height: 100%;
  }
  .photos[data-count='3'] .photo-tile:first-child {
    grid-row: 1 / 3;
  }

  /* 4 (or more, capped at 4 tiles) photos: 2x2 */
  .photos[data-count='4'] {
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
  }
  .photos[data-count='4'] .photo-tile {
    aspect-ratio: 1 / 1;
  }

  .body {
    font-size: 0.95rem;
    color: var(--ink);
  }
  .body :global(p + p) {
    margin-top: 0.8rem;
  }

  /* Teaser variant (homepage): tighter padding, smaller headline. */
  .update.teaser {
    padding: 1.2rem 1.4rem;
  }
  .update.teaser h3 {
    font-size: 1.1rem;
    margin-bottom: 0;
  }
</style>
