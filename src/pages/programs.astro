---
/**
 * programs.astro — PROGRAMS PAGE
 * -------------------------------
 * Sections: academics (Uganda National Curriculum) → planned facilities grid.
 *
 * MAINTAINER NOTES: the facilities list is the `facilities` array
 * below — add/edit items there, the grid renders itself.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import images from '../data/images.json';
import content from '../data/pages/programs.json';

const facilities = content.facilities.items;
---

<BaseLayout
  title="Programs"
  description="Nursery and primary education under the Uganda National Curriculum, on a campus designed for safe, dignified learning."
>
  <!-- ACADEMICS -->
  <section class="section">
    <div class="container academics">
      <div>
        <Eyebrow text={content.academics.eyebrow} />
        <h1>{content.academics.title}</h1>
        <p>
          {content.academics.body1}
        </p>
        <p>
          {content.academics.body2}
        </p>
      </div>
      <img
        src={images.programs.academics.src}
        alt={images.programs.academics.alt}
        loading="lazy"
      />
    </div>
  </section>

  <!-- FACILITIES -->
  <section class="section facilities">
    <div class="container">
      <Eyebrow text={content.facilities.eyebrow} />
      <h2>{content.facilities.title}</h2>
      <ul class="grid">
        {
          facilities.map((f) => (
            <li>
              <h3>{f.name}</h3>
              <p>{f.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  h1,
  h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }

  .academics {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .academics p {
    font-size: 1.05rem;
    color: var(--ink-muted);
    margin-bottom: 0.9rem;
    line-height: 1.75;
  }
  .academics img {
    border-radius: 8px;
    border: 3px solid var(--gold);
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    width: 100%;
  }

  .facilities {
    padding-top: 0;
  }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-top: 1.5rem;
  }
  .grid li {
    background: var(--paper);
    border: 1px solid var(--cream-deep);
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
  }
  .grid h3 {
    font-size: 1.02rem;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }
  .grid p {
    font-size: 0.84rem;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 820px) {
    .academics {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
