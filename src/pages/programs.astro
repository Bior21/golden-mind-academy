---
/**
 * programs.astro — PROGRAMS PAGE
 * -------------------------------
 * Sections: academics (Uganda National Curriculum) → planned facilities grid.
 *
 * MAINTAINER NOTES: the facilities list is the `facilities` array
 * below — add/edit items there, the grid renders itself.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import images from '../data/images.json';

/** Planned campus facilities, from the approved deck. */
const facilities = [
  { name: '9 classrooms', detail: 'Well-ventilated and safe' },
  { name: 'Separate latrines', detail: 'For boys and girls' },
  { name: 'Clean water', detail: 'Safe drinking water on site' },
  { name: 'Staff room', detail: 'Space for teachers' },
  { name: 'Admin office', detail: 'School administration' },
  { name: 'Play areas', detail: 'Outdoor learning and sport' },
  { name: 'Kitchen', detail: 'Meals prepared on site' },
  { name: 'School fence', detail: 'A secure perimeter' },
];
---

<BaseLayout
  title="Programs"
  description="Nursery and primary education under the Uganda National Curriculum, on a campus designed for safe, dignified learning."
>
  <!-- ACADEMICS -->
  <section class="section">
    <div class="container academics">
      <div>
        <Eyebrow text="Core academics" />
        <h1>Nursery and primary education, done well.</h1>
        <p>
          We plan to follow the Uganda National Curriculum across nursery and primary levels,
          supported by continuous assessment so every learner's progress is tracked.
        </p>
        <p>
          The goal: academic excellence built on strong foundations and a genuine love of
          learning — nurturing ethical, peaceful, and academically strong learners who become
          leaders in their communities.
        </p>
      </div>
      <img
        src={images.programs.academics.src}
        alt={images.programs.academics.alt}
        loading="lazy"
      />
    </div>
  </section>

  <!-- FACILITIES -->
  <section class="section facilities">
    <div class="container">
      <Eyebrow text="Planned facilities" />
      <h2>A campus designed for safe, dignified learning.</h2>
      <ul class="grid">
        {
          facilities.map((f) => (
            <li>
              <h3>{f.name}</h3>
              <p>{f.detail}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  h1,
  h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }

  .academics {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .academics p {
    font-size: 1.05rem;
    color: var(--ink-muted);
    margin-bottom: 0.9rem;
    line-height: 1.75;
  }
  .academics img {
    border-radius: 8px;
    border: 3px solid var(--gold);
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    width: 100%;
  }

  .facilities {
    padding-top: 0;
  }
  .grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.2rem;
    margin-top: 1.5rem;
  }
  .grid li {
    background: var(--paper);
    border: 1px solid var(--cream-deep);
    border-radius: 10px;
    padding: 1.1rem 1.2rem;
  }
  .grid h3 {
    font-size: 1.02rem;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }
  .grid p {
    font-size: 0.84rem;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 820px) {
    .academics {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
