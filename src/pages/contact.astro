---
/**
 * contact.astro — CONTACT PAGE
 * -----------------------------
 * Sections: contact form (Formspree) + direct details side by side.
 *
 * MAINTAINER NOTES:
 * - The form posts to Formspree. Set FORMSPREE_ID in
 *   src/config/site.ts (free account at formspree.io). Until then,
 *   the email address beside the form always works.
 * - The hidden "_gotcha" field is Formspree's honeypot: bots fill
 *   it in, humans never see it, and Formspree drops those entries.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { SITE, LINKS, FORMSPREE_ID } from '../config/site';
---

<BaseLayout
  title="Contact"
  description="We'd love to hear from you — questions, partnership ideas, or ways to give."
>
  <section class="section">
    <div class="container split">
      <!-- FORM -->
      <form method="POST" action={`https://formspree.io/f/${FORMSPREE_ID}`}>
        <Eyebrow text="Send a message" />

        <label for="name">Your name</label>
        <input id="name" name="name" type="text" required autocomplete="name" />

        <label for="email">Your email</label>
        <input id="email" name="email" type="email" required autocomplete="email" />

        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required></textarea>

        <!-- Honeypot spam trap — invisible to people, filled by bots -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <button class="btn btn-gold" type="submit">Send message</button>
        <p class="fallback">
          Prefer email? Write to us directly at <a href={LINKS.email}>{SITE.email}</a>.
        </p>
      </form>

      <!-- DIRECT DETAILS -->
      <div class="details">
        <Eyebrow text="Help us finish what we've started" />
        <h1>Every contribution builds a future.</h1>
        <p class="blurb">
          Every contribution builds a future for the refugee children to whom Golden Mind Academy
          will become a home.
        </p>
        <dl>
          <dt>Email</dt>
          <dd><a href={LINKS.email}>{SITE.email}</a></dd>
          <dt>Location</dt>
          <dd>
            {SITE.location.line1}, {SITE.location.line2}, {SITE.location.line3}
          </dd>
          <dt>Follow &amp; support</dt>
          <dd class="buttons">
            <a class="btn btn-gold" href={LINKS.gofundme} target="_blank" rel="noopener">
              GoFundMe
            </a>
            <a class="btn btn-ghost" href={LINKS.facebook} target="_blank" rel="noopener">
              Facebook
            </a>
          </dd>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3.5rem;
    align-items: start;
  }

  /* FORM */
  form {
    background: var(--paper);
    border: 1px solid var(--cream-deep);
    border-radius: 12px;
    padding: 1.8rem 2rem;
  }
  label {
    display: block;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--navy);
    margin: 1rem 0 0.3rem;
  }
  input,
  textarea {
    width: 100%;
    font: inherit;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--cream-deep);
    border-radius: 8px;
    background: #fff;
    color: var(--ink);
  }
  input:focus,
  textarea:focus {
    outline: 3px solid var(--gold);
    outline-offset: 1px;
    border-color: var(--gold);
  }
  /* Honeypot field: visually removed, still in the DOM for bots */
  input[name='_gotcha'] {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
  }
  button {
    margin-top: 1.3rem;
  }
  .fallback {
    font-size: 0.85rem;
    color: var(--ink-muted);
    margin-top: 0.9rem;
  }
  .fallback a {
    color: var(--gold-text);
    font-weight: 600;
  }

  /* DETAILS */
  h1 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    color: var(--navy);
    margin-bottom: 0.7rem;
  }
  .blurb {
    color: var(--ink-muted);
    margin-bottom: 1.4rem;
  }
  dt {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-text);
    margin-top: 1.1rem;
  }
  dd {
    margin: 0.2rem 0 0;
    color: var(--ink);
  }
  dd a:not(.btn) {
    color: var(--gold-text);
    font-weight: 600;
  }
  .buttons {
    display: flex;
    gap: 0.8rem;
    margin-top: 0.6rem;
  }

  @media (max-width: 820px) {
    .split {
      grid-template-columns: 1fr;
      gap: 2.2rem;
    }
  }
</style>
