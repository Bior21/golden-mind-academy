---
/**
 * privacy-policy.astro
 * --------------------
 * A short, honest privacy policy matching what the site actually
 * does (no analytics, no cookies; the contact form goes through
 * Formspree; donations go through GoFundMe).
 *
 * Linked from: Footer.astro (every page).
 * MAINTAINER NOTES: if analytics or any new service is ever added,
 * this page must be updated to say so.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import content from '../data/pages/privacy-policy.json';
import { mdInline } from '../lib/markdown';

const sections = content.sections.map((s) => ({
  heading: s.heading,
  body: mdInline(s.body.replace(/{{email}}/g, SITE.email)),
}));
---

<BaseLayout
  title="Privacy Policy"
  description="How Golden Mind Academy handles your information."
>
  <section class="section">
    <div class="container prose">
      <h1>{content.title}</h1>
      <p>{content.intro}</p>

      {sections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          <p set:html={s.body} />
        </>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 70ch;
  }
  h1 {
    color: var(--navy);
    margin-bottom: 1rem;
  }
  h2 {
    color: var(--navy);
    font-size: 1.2rem;
    margin: 1.6rem 0 0.4rem;
  }
  p {
    color: var(--ink-muted);
  }
  a {
    color: var(--gold-text);
    font-weight: 600;
  }
</style>
