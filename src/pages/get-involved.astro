---
/**
 * get-involved.astro — GET INVOLVED PAGE
 * ----------------------------------------
 * Sections: four ways to help → sponsorship tiers →
 * honest money-handling note → short FAQ.
 *
 * MAINTAINER NOTES: the `ways`, `tiers`, and `faqs` arrays below are
 * the content — edit them there, the layout renders itself.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { SITE, LINKS } from '../config/site';
import content from '../data/pages/get-involved.json';

const ways = content.ways.items;
const tiers = content.tiers.items;
const faqs = content.faq.items.map((faq) => ({
  q: faq.q,
  a: faq.a.replace(/{{email}}/g, SITE.email),
}));
---

<BaseLayout
  title="Get Involved"
  description="Whether you give once, contribute materials, or partner with us long-term — your support builds safe classrooms."
>
  <!-- FOUR WAYS -->
  <section class="section">
    <div class="container">
      <Eyebrow text={content.ways.eyebrow} />
      <h1>{content.ways.title}</h1>
      <ul class="ways">
        {
          ways.map((way) => (
            <li>
              <h3>{way.title}</h3>
              <p>{way.body}</p>
            </li>
          ))
        }
      </ul>
      <a class="btn btn-gold" href={LINKS.gofundme} target="_blank" rel="noopener">
        {content.ways.donateButton}
      </a>
    </div>
  </section>

  <!-- SPONSORSHIP TIERS -->
  <section class="section tiers-band">
    <div class="container">
      <Eyebrow text={content.tiers.eyebrow} />
      <h2>{content.tiers.title}</h2>
      <ul class="tiers">
        {
          tiers.map((tier) => (
            <li>
              <p class="amount">{tier.amount}</p>
              <p class="label">{tier.label}</p>
            </li>
          ))
        }
      </ul>
      <p class="partner">
        {content.tiers.partnerText} <a href={LINKS.email}>{SITE.email}</a>.
      </p>
    </div>
  </section>

  <!-- MONEY-HANDLING NOTE -->
  <section class="section">
    <div class="container">
      <div class="honest">
        <Eyebrow text={content.honest.eyebrow} />
        <p>
          {content.honest.bodyPre}{' '}
          <a href={LINKS.gofundme} target="_blank" rel="noopener">{content.honest.gofundmeLinkText}</a>{content.honest.bodyMid}{' '}
          <a href="/progress/">{content.honest.progressLinkText}</a>{content.honest.bodyPost}
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="container">
      <Eyebrow text={content.faq.eyebrow} />
      <h2>{content.faq.title}</h2>
      {
        faqs.map((faq) => (
          <details>
            <summary>{faq.q}</summary>
            <p>{faq.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  h1,
  h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    color: var(--navy);
    margin-bottom: 1.3rem;
  }

  .ways {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.2rem;
    margin-bottom: 1.8rem;
  }
  .ways li {
    background: var(--paper);
    border: 1px solid var(--cream-deep);
    border-radius: 10px;
    padding: 1.3rem 1.4rem;
  }
  .ways h3 {
    font-size: 1.05rem;
    color: var(--navy);
    margin-bottom: 0.35rem;
  }
  .ways p {
    font-size: 0.9rem;
    color: var(--ink-muted);
  }

  .tiers-band {
    background: var(--navy);
    color: var(--cream);
  }
  .tiers-band h2 {
    color: var(--cream);
  }
  .tiers {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.2rem;
    margin-bottom: 1.4rem;
  }
  .tiers li {
    background: var(--paper);
    color: var(--ink);
    border-radius: 10px;
    padding: 1.2rem 1.3rem;
  }
  .amount {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--navy);
  }
  .tiers .label {
    font-size: 0.88rem;
    color: var(--ink-muted);
  }
  .partner a {
    color: var(--gold-soft);
  }

  .honest {
    background: var(--cream-deep);
    border-left: 4px solid var(--gold);
    border-radius: 8px;
    padding: 1.5rem 1.7rem;
  }
  .honest p {
    color: var(--ink);
    max-width: 75ch;
  }
  .honest a {
    color: var(--gold-text);
    font-weight: 600;
  }

  .faq {
    padding-top: 0;
  }
  details {
    border-bottom: 1px solid var(--cream-deep);
    padding: 0.9rem 0;
  }
  summary {
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--navy);
    cursor: pointer;
  }
  details p {
    padding-top: 0.6rem;
    color: var(--ink-muted);
    max-width: 70ch;
  }

  @media (max-width: 820px) {
    .ways,
    .tiers {
      grid-template-columns: 1fr;
    }
  }
</style>
