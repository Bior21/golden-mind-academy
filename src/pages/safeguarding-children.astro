---
/**
 * safeguarding-children.astro
 * ---------------------------
 * The school's child-safeguarding commitment. Short but genuine —
 * this matters especially for an organization serving children.
 *
 * Linked from: Footer.astro (every page).
 * MAINTAINER NOTES: as the school formalizes (registration, staff
 * hiring), expand this into the full adopted policy document.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS } from '../config/site';
import content from '../data/pages/safeguarding-children.json';
import { mdInline } from '../lib/markdown';

const concernBody = mdInline(content.concern.body.replace(/{{email}}/g, `[${SITE.email}](${LINKS.email})`));
---

<BaseLayout
  title="Safeguarding Children"
  description="Golden Mind Academy's commitment to the safety and dignity of every child."
>
  <section class="section">
    <div class="container prose">
      <h1>{content.title}</h1>
      <p>{content.intro}</p>

      <h2>{content.commitments.heading}</h2>
      <ul>
        {content.commitments.items.map((item) => (
          <li>{item}</li>
        ))}
      </ul>

      <h2>{content.concern.heading}</h2>
      <p set:html={concernBody} />

      <p class="note">
        {content.note}
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose {
    max-width: 70ch;
  }
  h1 {
    color: var(--navy);
    margin-bottom: 1rem;
  }
  h2 {
    color: var(--navy);
    font-size: 1.2rem;
    margin: 1.6rem 0 0.4rem;
  }
  p,
  li {
    color: var(--ink-muted);
  }
  ul {
    padding-left: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  a {
    color: var(--gold-text);
    font-weight: 600;
  }
  .note {
    margin-top: 1.4rem;
    font-style: italic;
    font-size: 0.92rem;
  }
</style>
