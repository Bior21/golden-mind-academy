---
/**
 * progress.astro — PROGRESS PAGE
 * --------------------------------
 * Sections: current status + photo gallery → construction roadmap
 * (from roadmap.json) → funding tracker (from funding.json) →
 * Updates feed (from src/content/updates/).
 *
 * The Updates feed is a vertical timeline with gold dot markers,
 * deliberately echoing the Roadmap: the roadmap is the plan, the
 * updates are the receipts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ArchImage from '../components/ArchImage.astro';
import Roadmap from '../components/Roadmap.astro';
import FundingTracker from '../components/FundingTracker.astro';
import UpdateCard from '../components/UpdateCard.astro';
import { LINKS } from '../config/site';
import { getCollection } from 'astro:content';

/* All updates, newest first. */
const updates = (await getCollection('updates')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Progress"
  description="Where construction stands today, our roadmap to opening, and our commitment to transparency."
>
  <!-- STATUS + GALLERY -->
  <section class="section">
    <div class="container">
      <Eyebrow text="Early structural phase — in progress" />
      <h1>Construction began in April 2026.</h1>
      <p class="lede">
        The timber frame is up and roofing is in place across the main building. Continued
        progress depends on securing additional materials, labor, and funding. Every gift takes us
        a measurable step closer to walled, finished classrooms.
      </p>
      <div class="gallery">
        <ArchImage
          src="/images/construction-frame.jpg"
          alt="The timber roof truss structure rising across the full length of the classroom block before roofing sheets were installed."
          caption="Timber frame rising across the classroom block."
          arch={false}
        />
        <ArchImage
          src="/images/frame.jpg"
          alt="The long classroom block with green roofing sheets installed, seen from the school grounds."
          caption="Green roofing installed over the main building."
          arch={false}
        />
        <ArchImage
          src="/images/hero.jpg"
          alt="Wide view of the Golden Mind Academy site in Ayilo I Refugee Settlement: three roofed classroom buildings at dusk."
          caption="The full site at Ayilo, Northern Uganda."
          arch={false}
        />
      </div>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="section roadmap">
    <div class="container">
      <Eyebrow text="The road to 2027" />
      <h2>Our Construction Roadmap.</h2>
      <Roadmap />
    </div>
  </section>

  <!-- FUNDING TRACKER -->
  <section class="section tracker">
    <div class="container">
      <Eyebrow text="Funding tracker" />
      <FundingTracker />
      <p class="give">
        <a class="btn btn-gold" href={LINKS.gofundme} target="_blank" rel="noopener">
          Donate on GoFundMe
        </a>
      </p>
    </div>
  </section>

  <!-- UPDATES FEED -->
  <section class="section" id="updates">
    <div class="container">
      <Eyebrow text="Updates" />
      <h2>Follow the build.</h2>
      <p class="lede">
        Dated updates from the field — construction progress, fundraising milestones, community
        activities, and school announcements. You can also
        <a href={LINKS.facebook} target="_blank" rel="noopener">follow along on Facebook</a>.
      </p>

      {
        updates.length === 0 ? (
          /* Empty state: shown only if every update file is removed. */
          <p class="empty">Updates coming soon — construction is underway.</p>
        ) : (
          <ol class="feed">
            {updates.map((update) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <UpdateCard update={update} />
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  h1,
  h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }
  .lede {
    max-width: 64ch;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink-muted);
    margin-bottom: 1.6rem;
  }
  .lede a {
    color: var(--gold-text);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .roadmap {
    padding-top: 0;
  }

  .tracker {
    background: var(--cream);
  }
  .give {
    margin-top: 1.8rem;
  }

  /* Updates feed: vertical timeline with gold dots, echoing Roadmap */
  .feed {
    list-style: none;
    border-left: 2px solid var(--cream-deep);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding-left: 1.6rem;
    margin-left: 0.6rem;
  }
  .feed li {
    position: relative;
  }
  .dot {
    position: absolute;
    /* Center a 14px dot on the 2px border:
       -1.6rem undoes padding-left, -1px reaches border center, -7px is half dot width. */
    left: calc(-1.6rem - 8px);
    top: 1.9rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--gold);
  }
  .empty {
    color: var(--ink-muted);
    font-style: italic;
  }

  @media (max-width: 820px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
