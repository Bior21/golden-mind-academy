---
/**
 * progress.astro — PROGRESS PAGE
 * --------------------------------
 * Sections: current status + photo gallery → construction roadmap
 * (from roadmap.json) → funding tracker (from funding.json) →
 * Updates feed (from src/content/updates/).
 *
 * The Updates feed is a vertical timeline with gold dot markers,
 * deliberately echoing the Roadmap: the roadmap is the plan, the
 * updates are the receipts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import ArchImage from '../components/ArchImage.astro';
import Roadmap from '../components/Roadmap.astro';
import FundingTracker from '../components/FundingTracker.astro';
import UpdateCard from '../components/UpdateCard.astro';
import { LINKS } from '../config/site';
import { getCollection } from 'astro:content';
import images from '../data/images.json';
import content from '../data/pages/progress.json';

/* All updates, newest first. */
const updates = (await getCollection('updates')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout
  title="Progress"
  description="Where construction stands today, our roadmap to opening, and our commitment to transparency."
>
  <!-- STATUS + GALLERY -->
  <section class="section">
    <div class="container">
      <Eyebrow text={content.status.eyebrow} />
      <h1>{content.status.title}</h1>
      <p class="lede">
        {content.status.lede}
      </p>
      <div class="gallery">
        <ArchImage
          src={images.progress.gallery1.src}
          alt={images.progress.gallery1.alt}
          caption={images.progress.gallery1.caption}
          focus={images.progress.gallery1.focus}
          arch={false}
        />
        <ArchImage
          src={images.progress.gallery2.src}
          alt={images.progress.gallery2.alt}
          caption={images.progress.gallery2.caption}
          focus={images.progress.gallery2.focus}
          arch={false}
        />
        <ArchImage
          src={images.progress.gallery3.src}
          alt={images.progress.gallery3.alt}
          caption={images.progress.gallery3.caption}
          focus={images.progress.gallery3.focus}
          arch={false}
        />
      </div>
    </div>
  </section>

  <!-- ROADMAP -->
  <section class="section roadmap">
    <div class="container">
      <Eyebrow text={content.roadmap.eyebrow} />
      <h2>{content.roadmap.title}</h2>
      <Roadmap />
    </div>
  </section>

  <!-- FUNDING TRACKER -->
  <section class="section tracker">
    <div class="container">
      <Eyebrow text={content.tracker.eyebrow} />
      <FundingTracker />
      <p class="give">
        <a class="btn btn-gold" href={LINKS.gofundme} target="_blank" rel="noopener">
          {content.tracker.donateButton}
        </a>
      </p>
    </div>
  </section>

  <!-- UPDATES FEED -->
  <section class="section" id="updates">
    <div class="container">
      <Eyebrow text={content.updates.eyebrow} />
      <h2>{content.updates.title}</h2>
      <p class="lede">
        {content.updates.lede}
        <a href={LINKS.facebook} target="_blank" rel="noopener">{content.updates.ledeLink}</a>.
      </p>

      {
        updates.length === 0 ? (
          /* Empty state: shown only if every update file is removed. */
          <p class="empty">{content.updates.empty}</p>
        ) : (
          <ol class="feed">
            {updates.map((update) => (
              <li>
                <span class="dot" aria-hidden="true" />
                <UpdateCard update={update} />
              </li>
            ))}
          </ol>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  h1,
  h2 {
    font-size: clamp(1.5rem, 3.2vw, 2.1rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }
  .lede {
    max-width: 64ch;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--ink-muted);
    margin-bottom: 1.6rem;
  }
  .lede a {
    color: var(--gold-text);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.4rem;
  }

  .roadmap {
    padding-top: 0;
  }

  .tracker {
    background: var(--cream);
  }
  .give {
    margin-top: 1.8rem;
  }

  /* Updates feed: vertical timeline with gold dots, echoing Roadmap */
  .feed {
    list-style: none;
    border-left: 2px solid var(--cream-deep);
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    padding-left: 1.6rem;
    margin-left: 0.6rem;
  }
  .feed li {
    position: relative;
  }
  .dot {
    position: absolute;
    /* Center a 14px dot on the 2px border:
       -1.6rem undoes padding-left, -1px reaches border center, -7px is half dot width. */
    left: calc(-1.6rem - 8px);
    top: 1.9rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--gold);
  }
  .empty {
    color: var(--ink-muted);
    font-style: italic;
  }

  @media (max-width: 820px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
