---
/**
 * about.astro — ABOUT PAGE
 * ------------------------
 * Sections: founder story → who we serve → team.
 * Team bios are real content approved in planning (no placeholders).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import StatCard from '../components/StatCard.astro';
import images from '../data/images.json';
---

<BaseLayout
  title="About"
  description="The story of Golden Mind Academy: founded by a former refugee of Ayilo Settlement, now building the school he never had."
>
  <!-- FOUNDER STORY -->
  <section class="section story-section">
    <div class="container">

      <!-- Header zone: two-column grid — text LEFT, photo RIGHT.
           The blockquote (with the founder attribution) lives in the left column so
           align-items: stretch makes the photo fill exactly to the attribution line.
           Moving it below the grid would shorten the photo to just the h1 height. -->
      <div class="story-header">
        <div class="story-intro">
          <Eyebrow text="— Our Story" />
          <h1>From the Ayilo refugee camp in Uganda to Yale — and now building the school in Ayilo.</h1>
          <blockquote>
            <p class="quote-text">"You don't choose to become a refugee. But you can choose to rise beyond it."</p>
            <cite>— <strong>Dut Phillip Jool Joh, Founder</strong></cite>
          </blockquote>
        </div>
        <div class="story-img-col">
          <img
            class="story-img"
            src={images.about.story.src}
            alt={images.about.story.alt}
            loading="lazy"
          />
        </div>
      </div>

      <!-- Full-width zone: four body paragraphs -->
      <div class="story-body">
        <p>
          Dut Phillip Jool Joh was born in Bor, South Sudan, into a family where no one had
          ever attended school. In 2013, when the civil war broke out, he fled to the Ayilo
          Refugee Settlement in Uganda, leaving his family behind in the hope that education
          would help him build a different future. Life in Ayilo was far from easy, but he
          refused to give up. From studying under trees and, at times, in temporary classrooms
          to spending many evenings reading under solar-powered street lights because there was
          no electricity at home, Dut believed that education would one day turn the page on
          his life.
        </p>
        <p>
          In 2017, Dut sat for Uganda's Primary Leaving Examinations and ranked among the top
          1% of pupils nationwide. His performance earned him a scholarship to Darling Wisdom
          Academy Secondary School in Juba, South Sudan, where he graduated at the top of his
          class in 2022. After high school, Dut became one of only two South Sudanese students
          selected for the Bridge2Rwanda Scholars Program in Kigali, Rwanda — a highly
          competitive college preparatory program that prepares outstanding East African students
          for university studies abroad.
        </p>
        <p>
          In 2024, Dut received full scholarships to Yale University, Columbia University, and
          Emory University, with a combined value of more than <strong>US$1.13 million</strong>
          over four years. For a young man who had once studied under trees and borrowed books,
          the moment was almost unbelievable.
        </p>
        <p>
          But reaching Yale was never the end of the journey. Growing up in Ayilo Refugee
          Settlement, Dut witnessed thousands of refugee children facing the same barriers he
          had overcome — overcrowded classrooms, limited learning materials, and too few
          opportunities. Those experiences inspired him to establish
          <strong>Golden Mind Academy</strong>, a refugee-led Nursery and Primary School in
          Ayilo Refugee Settlement. Through Golden Mind Academy, Dut hopes to give refugee
          children the same opportunity that transformed his own life: access to quality
          education, a safe place to learn, and the chance to build a brighter future. The
          school stands as a reminder that while conflict can force people from their homes, it
          does not have to define their future.
        </p>
      </div>

    </div>
  </section>

  <!-- WHO WE SERVE -->
  <section class="serve">
    <div class="container">
      <Eyebrow text="Who we serve" onDark />
      <h2>Refugee children in Ayilo Camp</h2>
      <p class="serve-lede">
        We focus on school-age students who currently lack access to stable, safe, and adequately
        resourced learning environments — from both the refugee and host communities.
      </p>
      <div class="serve-stats">
        <StatCard value="500–800" label="children served each year" onDark />
        <StatCard value="Nursery + Primary" label="levels offered" onDark />
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section">
    <div class="container">
      <h2 class="team-title">Our Team</h2>
      <div class="team">
        <article class="member">
          <img
            src={images.about.founder.src}
            alt={images.about.founder.alt}
            loading="lazy"
          />
          <h3>Dut Phillip Jool Joh</h3>
          <p class="role">Founder</p>
          <p>
            Born in Bor, South Sudan, Dut fled to Ayilo Refugee Settlement in 2013 and studied
            under trees and streetlights before ranking in the top 1% of Uganda's Primary Leaving
            Examinations. A Bridge2Rwanda Scholar, he is now a student at Yale University on a full
            scholarship. He founded Golden Mind Academy to give the children of Ayilo the same
            chance education gave him.
          </p>
        </article>
        <article class="member">
          <img
            src={images.about.lead.src}
            alt={images.about.lead.alt}
            loading="lazy"
          />
          <h3>Mawut Peter Nyok Mabior</h3>
          <p class="role">Project Lead</p>
          <p>
            Mawut leads the day-to-day work on the ground in Ayilo — coordinating construction,
            purchasing materials, and working with settlement leadership and the community. He is
            the project's eyes, hands, and voice on site.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--navy);
    line-height: 1.2;
    margin-bottom: 0;
  }
  h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }

  /* FOUNDER STORY */
  .story-section {
    background: #F6F1E7;
  }

  /* Header zone: both columns stretch to same height so photo ends at attribution line */
  .story-header {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: stretch;
    margin-bottom: 2.5rem;
  }
  .story-intro {
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  /* Wrapper: no in-flow content so it doesn't push the row height.
     Grid stretches it to match the left column height.
     min-height ensures the photo never looks too short if left column is edited. */
  .story-img-col {
    position: relative;
    min-height: 260px;
  }

  /* Image fills the wrapper via absolute positioning */
  .story-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 8px;
    display: block;
  }

  /* Full-width body zone */
  .story-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  blockquote {
    border-left: 3px solid var(--gold);
    padding-left: 1.1rem;
  }
  .quote-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--navy);
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }
  blockquote cite {
    display: block;
    font-size: 0.85rem;
    font-style: normal;
    color: var(--gold-text);
  }
  .story-body p {
    font-size: 1.05rem;
    color: var(--ink-muted);
    line-height: 1.8;
  }

  /* WHO WE SERVE */
  .serve {
    background: var(--navy);
    color: var(--cream);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .serve h2 {
    color: var(--cream);
  }
  .serve-lede {
    max-width: 60ch;
    color: rgba(241, 235, 220, 0.85);
    margin-bottom: 1.6rem;
  }
  /* minmax(0, 320px) caps each card at 320px — the two-card row auto-centres
     within the navy band without needing an explicit justify-content. */
  .serve-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 320px));
    gap: 2rem;
  }

  /* TEAM */
  .team-title {
    display: block;
    text-align: center;
    text-transform: uppercase;
    background: var(--navy);
    color: #e6b94d;
    padding: 0.55em 1.4em;
    width: fit-content;
    margin-inline: auto;
    margin-bottom: 0;
  }
  .team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }
  .member {
    flex: 0 1 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .member img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 3px solid var(--gold);
    object-fit: cover;
    object-position: top center;
    margin-bottom: 1rem;
    display: block;
  }
  .member h3 {
    font-size: 1.2rem;
    color: var(--navy);
  }
  .role {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold-text);
    margin: 0.2rem 0 0.7rem;
  }
  .member p:not(.role) {
    font-size: 0.93rem;
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .story-header {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    /* On mobile the header grid is single-column, so the image column
       loses its stretch-to-text-height behaviour. Set an explicit height
       for the now-stacked image block (the absolutely-positioned img
       fills this via inset: 0). Must be <= any min-height on the wrapper
       to avoid a gap at the bottom. */
    .story-img-col {
      min-height: 240px;
    }
    /* .team is a flex container — gap applies, grid properties do not. */
    .team {
      gap: 2rem;
    }
    .serve-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
