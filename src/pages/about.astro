---
/**
 * about.astro — ABOUT PAGE
 * ------------------------
 * Sections: founder story → who we serve → team.
 * Team bios are real content approved in planning (no placeholders).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Eyebrow from '../components/Eyebrow.astro';
import StatCard from '../components/StatCard.astro';
import images from '../data/images.json';
import content from '../data/pages/about.json';
import { mdInline } from '../lib/markdown';
---

<BaseLayout
  title="About"
  description="The story of Golden Mind Academy: founded by a former refugee of Ayilo Settlement, now building the school he never had."
>
  <!-- FOUNDER STORY -->
  <section class="section story-section">
    <div class="container">

      <!-- Header zone: two-column grid — text LEFT, photo RIGHT.
           The blockquote (with the founder attribution) lives in the left column so
           align-items: stretch makes the photo fill exactly to the attribution line.
           Moving it below the grid would shorten the photo to just the h1 height. -->
      <div class="story-header">
        <div class="story-intro">
          <Eyebrow text={content.story.eyebrow} />
          <h1>{content.story.title}</h1>
          <blockquote>
            <p class="quote-text">{content.story.quote}</p>
            <cite>— <strong>{content.story.quoteAttribution}</strong></cite>
          </blockquote>
        </div>
        <div class="story-img-col">
          <img
            class="story-img"
            src={images.about.story.src}
            alt={images.about.story.alt}
            style={`object-position: ${images.about.story.focus}`}
            loading="lazy"
          />
        </div>
      </div>

      <!-- Full-width zone: four body paragraphs -->
      <div class="story-body">
        <p>{content.story.body1}</p>
        <p>{content.story.body2}</p>
        <p set:html={mdInline(content.story.body3)} />
        <p set:html={mdInline(content.story.body4)} />
      </div>

    </div>
  </section>

  <!-- WHO WE SERVE -->
  <section class="serve">
    <div class="container">
      <Eyebrow text={content.serve.eyebrow} onDark />
      <h2>{content.serve.title}</h2>
      <p class="serve-lede">
        {content.serve.lede}
      </p>
      <div class="serve-stats">
        <StatCard value={content.serve.stat1Value} label={content.serve.stat1Label} onDark />
        <StatCard value={content.serve.stat2Value} label={content.serve.stat2Label} onDark />
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="section">
    <div class="container">
      <h2 class="team-title">{content.team.title}</h2>
      <div class="team">
        <article class="member">
          <img
            src={images.about.founder.src}
            alt={images.about.founder.alt}
            style={`object-position: ${images.about.founder.focus}`}
            loading="lazy"
          />
          <h3>{content.team.founderName}</h3>
          <p class="role">{content.team.founderRole}</p>
          <p>
            {content.team.founderBio}
          </p>
        </article>
        <article class="member">
          <img
            src={images.about.lead.src}
            alt={images.about.lead.alt}
            style={`object-position: ${images.about.lead.focus}`}
            loading="lazy"
          />
          <h3>{content.team.leadName}</h3>
          <p class="role">{content.team.leadRole}</p>
          <p>
            {content.team.leadBio}
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  h1 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--navy);
    line-height: 1.2;
    margin-bottom: 0;
  }
  h2 {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }

  /* FOUNDER STORY */
  .story-section {
    background: #F6F1E7;
  }

  /* Header zone: both columns stretch to same height so photo ends at attribution line */
  .story-header {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem;
    align-items: stretch;
    margin-bottom: 2.5rem;
  }
  .story-intro {
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  /* Wrapper: no in-flow content so it doesn't push the row height.
     Grid stretches it to match the left column height.
     min-height ensures the photo never looks too short if left column is edited. */
  .story-img-col {
    position: relative;
    min-height: 260px;
  }

  /* Image fills the wrapper via absolute positioning */
  .story-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border-radius: 8px;
    display: block;
  }

  /* Full-width body zone */
  .story-body {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  blockquote {
    border-left: 3px solid var(--gold);
    padding-left: 1.1rem;
  }
  .quote-text {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--navy);
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }
  blockquote cite {
    display: block;
    font-size: 0.85rem;
    font-style: normal;
    color: var(--gold-text);
  }
  .story-body p {
    font-size: 1.05rem;
    color: var(--ink-muted);
    line-height: 1.8;
  }

  /* WHO WE SERVE */
  .serve {
    background: var(--navy);
    color: var(--cream);
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .serve h2 {
    color: var(--cream);
  }
  .serve-lede {
    max-width: 60ch;
    color: rgba(241, 235, 220, 0.85);
    margin-bottom: 1.6rem;
  }
  /* minmax(0, 320px) caps each card at 320px — the two-card row auto-centres
     within the navy band without needing an explicit justify-content. */
  .serve-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 320px));
    gap: 2rem;
  }

  /* TEAM */
  .team-title {
    display: block;
    text-align: center;
    text-transform: uppercase;
    background: var(--navy);
    color: #e6b94d;
    padding: 0.55em 1.4em;
    width: fit-content;
    margin-inline: auto;
    margin-bottom: 0;
  }
  .team {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2.5rem;
    margin-top: 1.5rem;
  }
  .member {
    flex: 0 1 300px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .member img {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    border: 3px solid var(--gold);
    object-fit: cover;
    object-position: top center;
    margin-bottom: 1rem;
    display: block;
  }
  .member h3 {
    font-size: 1.2rem;
    color: var(--navy);
  }
  .role {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--gold-text);
    margin: 0.2rem 0 0.7rem;
  }
  .member p:not(.role) {
    font-size: 0.93rem;
    color: var(--ink-muted);
  }

  @media (max-width: 820px) {
    .story-header {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    /* On mobile the header grid is single-column, so the image column
       loses its stretch-to-text-height behaviour. Set an explicit height
       for the now-stacked image block (the absolutely-positioned img
       fills this via inset: 0). Must be <= any min-height on the wrapper
       to avoid a gap at the bottom. */
    .story-img-col {
      min-height: 240px;
    }
    /* .team is a flex container — gap applies, grid properties do not. */
    .team {
      gap: 2rem;
    }
    .serve-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
